<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  CruiseLAN does not track. Nothing here is combined with data from other companies,
	  used for advertising, or shared with a data broker. There are no third-party SDKs.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  Only what the online game service holds is collected (below). Push notification addresses
	  are given to that game alone and forgotten with it. Diagnostics stay on the device: this
	  build has no telemetry endpoint (`CruiseLANTelemetryEndpoint`), so the sharing switch is
	  hidden. If an endpoint is ever added, declare ProductInteraction, PerformanceData and
	  OtherDiagnosticData (not linked, analytics) here again; see docs/decisions/telemetry.md.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
		  Online games (version 2): when the internet is reachable, the online game service
		  (server/game-worker, on Cloudflare) holds each game's moves and state and the nickname
		  each player uses at that table, so it can host the game. There are no accounts; a seat
		  is a random per-game secret (stored hashed), so nothing is linked to a person or across
		  games. Deleted automatically: 24 h unused, 7 days idle, 30 days after the game ends.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeGameplayContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			  UserDefaults holds this app's own settings only: the nickname, the diagnostics
			  opt-in, and the two rotating pseudonyms (`TelemetryInstallId`, `LANNodeId`).
			  CA92.1 = access info from the same app.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
