<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets Troubleshooting show the Wi-Fi network name (NEHotspotNetwork.fetchCurrent).
	     iOS also requires Location permission for that, which is asked only when the user
	     taps "Show Wi-Fi name". -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<!-- Invite links (https://cruiselan-games.dguilloryjr.workers.dev/join/CODE) open the app
	     straight into the game. The server serves the matching apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:cruiselan-games.dguilloryjr.workers.dev</string>
	</array>
</dict>
</plist>
