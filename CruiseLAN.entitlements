<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets Troubleshooting show the Wi-Fi network name (NEHotspotNetwork.fetchCurrent).
	     iOS also requires Location permission for that, which is asked only when the user
	     taps "Show Wi-Fi name". -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
