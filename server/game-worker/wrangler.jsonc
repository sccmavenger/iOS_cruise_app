{
  // CruiseLAN online games. Deploy: ./build-rules.sh && npx wrangler deploy
  "name": "cruiselan-games",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "LobbyDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyDirectory"] }
  ],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }],
  // Per-address limits: creating rooms, and guessing invite codes. Generous, because a whole
  // ship or hotel can share one public address; codes are 40-bit, so guessing stays hopeless.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    { "name": "JOIN_LIMITER", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } },
    // Invite pages and room info say whether a code exists, so they're throttled too.
    { "name": "INFO_LIMITER", "namespace_id": "4103", "simple": { "limit": 240, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
